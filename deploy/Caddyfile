# Replace skills.example.com with the production hostname.
#
# Caddy will request and renew public TLS certificates automatically when DNS
# points to this host and ports 80/443 are reachable from the internet.
{
	# Keep Caddy's config/admin API bound to loopback.
	admin 127.0.0.1:2019
}

skills.example.com {
	# This production example assumes the hostname is proxied through Cloudflare.
	# Remove this matcher/respond pair if you expose Caddy directly.
	@directOrigin not remote_ip private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	respond @directOrigin "direct origin access is not allowed" 403

	log {
		output file /var/log/caddy/skillsdex-access.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
		}
	}

	reverse_proxy 127.0.0.1:8765
}
